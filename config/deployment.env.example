# Travel-Laser deployment values gathered on the Orange Pi.
# scripts/deploy.sh copies this to /etc/travel-laser/deployment.env,
# auto-fills safe single-device values, and applies them to controller.yaml.

TRAVEL_LASER_TAILSCALE_IP=

LASER_USB_VID=
LASER_USB_PID=
LASER_USB_SERIAL=
LASER_USB_DESCRIPTION=

CAMERA_USB_VID=
CAMERA_USB_PID=
CAMERA_USB_SERIAL=
CAMERA_USB_DESCRIPTION=
CAMERA_DEVICE=
CAMERA_RESOLUTION=highest_available
CAMERA_FPS=30
CAMERA_STREAM_NAME=cam
CAMERA_STREAM_URL=

# Physically validated Orange Pi Zero 3 display/touch values.
DISPLAY_SPI_DEVICE=/dev/spidev1.1
TOUCH_I2C_BUS=2
BACKLIGHT_GPIO_CHIP=
BACKLIGHT_GPIO_LINE=

# Validated Armbian network interface names.
ETH_IFACE=end0
ETH_METRIC=100
WIFI_UPLINK_IFACE=wlan0
WIFI_UPLINK_METRIC=300

VIRTUALHERE_SERVICE_NAME=virtualhere
VIRTUALHERE_BACKEND_CONTROLS_SERVICE=false

# Start services after the remaining deployment placeholders are completed
# and K1 safety wiring has been verified.
START_SERVICES=true
