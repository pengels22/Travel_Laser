# Travel-Laser deployment values gathered on the Orange Pi.
# scripts/deploy.sh copies this to /etc/travel-laser/deployment.env,
# auto-fills safe single-device values, and stops for anything ambiguous.

# Auto-filled when Tailscale is installed, logged in, and has an IPv4 address.
TRAVEL_LASER_TAILSCALE_IP=

# Auto-filled only when exactly one serial USB device is present.
# If multiple serial devices exist, choose the laser controller manually.
# Prefer VID/PID plus serial if available; use description only as a fallback.
LASER_USB_VID=
LASER_USB_PID=
LASER_USB_SERIAL=
LASER_USB_DESCRIPTION=

# CAMERA_DEVICE is auto-filled only when exactly one /dev/v4l/by-id camera exists.
# Camera USB identity values are optional documentation until future matching needs them.
CAMERA_USB_VID=
CAMERA_USB_PID=
CAMERA_USB_SERIAL=
CAMERA_USB_DESCRIPTION=
CAMERA_DEVICE=
CAMERA_RESOLUTION=highest_available
CAMERA_FPS=30
CAMERA_STREAM_NAME=cam
CAMERA_STREAM_URL=

# Display/touch values are expected defaults; change only if diagnostics prove different.
DISPLAY_SPI_DEVICE=/dev/spidev1.0
TOUCH_I2C_BUS=3
BACKLIGHT_GPIO_CHIP=
BACKLIGHT_GPIO_LINE=

# VirtualHere is backup/service mode. Confirm actual service name on the Orange Pi.
VIRTUALHERE_SERVICE_NAME=virtualhere
VIRTUALHERE_BACKEND_CONTROLS_SERVICE=false

# Service startup switch used by scripts/deploy.sh after placeholders are valid.
START_SERVICES=true
